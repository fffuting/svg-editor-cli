{
  "name": "svg-editor-cli",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "cli": "node dist/src/bootstrap/main.js",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "check": "npm run typecheck && npm run lint && npm test",
    "coverage": "npm run build && node --experimental-test-coverage --test dist/tests/*.test.js",
    "lint": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\""
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "prettier": "^3.9.10",
    "typescript": "5.9.3"
  }
}
